{
  "$id": "https://kanbanly.local/schemas/board-settings.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActionsWidget": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "actions",
          "title": "Type",
          "type": "string"
        },
        "add_card": {
          "default": true,
          "title": "Add Card",
          "type": "boolean"
        },
        "export": {
          "default": true,
          "title": "Export",
          "type": "boolean"
        },
        "import": {
          "default": true,
          "title": "Import",
          "type": "boolean"
        },
        "reset": {
          "default": true,
          "title": "Reset",
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "title": "ActionsWidget",
      "type": "object"
    },
    "BadgeConfig": {
      "additionalProperties": true,
      "properties": {
        "dimension": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Dimension",
          "type": "string"
        },
        "display": {
          "default": "name",
          "enum": [
            "name",
            "short",
            "icon",
            "icon+name"
          ],
          "title": "Display",
          "type": "string"
        },
        "style": {
          "default": "neutral",
          "enum": [
            "per-value",
            "neutral",
            "outlined",
            "filled",
            "dot"
          ],
          "title": "Style",
          "type": "string"
        },
        "radius": {
          "anyOf": [
            {
              "maximum": 999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius"
        },
        "size": {
          "default": "sm",
          "enum": [
            "sm",
            "md"
          ],
          "title": "Size",
          "type": "string"
        },
        "hide_values": {
          "default": [],
          "items": {
            "maxLength": 120,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Hide Values",
          "type": "array"
        }
      },
      "required": [
        "dimension"
      ],
      "title": "BadgeConfig",
      "type": "object"
    },
    "BoardLayout": {
      "additionalProperties": true,
      "properties": {
        "swimlanes": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Swimlanes"
        }
      },
      "title": "BoardLayout",
      "type": "object"
    },
    "CardAccent": {
      "additionalProperties": true,
      "properties": {
        "source": {
          "default": "none",
          "pattern": "^(none|column|dimension:[A-Za-z0-9_-]+|field:[A-Za-z0-9_-]+)$",
          "title": "Source",
          "type": "string"
        },
        "style": {
          "default": "left-border",
          "enum": [
            "left-border",
            "top-border",
            "background-tint",
            "dot",
            "full-border"
          ],
          "title": "Style",
          "type": "string"
        },
        "width": {
          "default": 3,
          "maximum": 12,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "title": "CardAccent",
      "type": "object"
    },
    "CardLayout": {
      "additionalProperties": true,
      "properties": {
        "radius": {
          "default": 8,
          "maximum": 32,
          "minimum": 0,
          "title": "Radius",
          "type": "integer"
        },
        "padding": {
          "default": [
            10,
            12
          ],
          "items": {
            "maximum": 48,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Padding",
          "type": "array"
        },
        "gap": {
          "default": 8,
          "maximum": 48,
          "minimum": 0,
          "title": "Gap",
          "type": "integer"
        },
        "shadow": {
          "default": "none",
          "enum": [
            "none",
            "sm",
            "md"
          ],
          "title": "Shadow",
          "type": "string"
        },
        "border": {
          "default": true,
          "title": "Border",
          "type": "boolean"
        },
        "hover": {
          "default": "border",
          "enum": [
            "none",
            "border",
            "lift",
            "glow"
          ],
          "title": "Hover",
          "type": "string"
        },
        "accent": {
          "$ref": "#/$defs/CardAccent",
          "default": {
            "source": "none",
            "style": "left-border",
            "width": 3
          }
        },
        "face": {
          "default": [
            "title",
            "description",
            "badges"
          ],
          "items": {
            "enum": [
              "title",
              "description",
              "badges",
              "fields",
              "cover",
              "assignees",
              "due_date",
              "checklist_progress",
              "comments_count",
              "custom_text"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Face",
          "type": "array"
        },
        "badges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BadgeConfig"
          },
          "maxItems": 20,
          "title": "Badges",
          "type": "array"
        },
        "custom_text": {
          "default": "",
          "maxLength": 300,
          "title": "Custom Text",
          "type": "string"
        }
      },
      "title": "CardLayout",
      "type": "object"
    },
    "ColorBackground": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "color",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 48,
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|\\{[a-z][a-z0-9-]{0,39}\\})$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "ColorBackground",
      "type": "object"
    },
    "ColumnLayout": {
      "additionalProperties": true,
      "properties": {
        "min_width": {
          "default": 280,
          "maximum": 800,
          "minimum": 120,
          "title": "Min Width",
          "type": "integer"
        },
        "fixed_width": {
          "anyOf": [
            {
              "maximum": 800,
              "minimum": 120,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Width"
        },
        "radius": {
          "default": 10,
          "maximum": 32,
          "minimum": 0,
          "title": "Radius",
          "type": "integer"
        },
        "header_style": {
          "default": "flat-with-divider",
          "enum": [
            "flat-with-divider",
            "pill",
            "color-bar"
          ],
          "title": "Header Style",
          "type": "string"
        },
        "show_count": {
          "default": true,
          "title": "Show Count",
          "type": "boolean"
        },
        "show_wip": {
          "default": true,
          "title": "Show Wip",
          "type": "boolean"
        },
        "collapsible": {
          "default": false,
          "title": "Collapsible",
          "type": "boolean"
        },
        "empty_text": {
          "default": "Пусто",
          "maxLength": 300,
          "title": "Empty Text",
          "type": "string"
        }
      },
      "title": "ColumnLayout",
      "type": "object"
    },
    "EditorLayout": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "default": "drawer",
          "enum": [
            "modal",
            "drawer"
          ],
          "title": "Type",
          "type": "string"
        },
        "fields_grid": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Fields Grid",
          "type": "integer"
        },
        "fields": {
          "default": [],
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 120,
          "title": "Fields",
          "type": "array"
        }
      },
      "title": "EditorLayout",
      "type": "object"
    },
    "FilterBarWidget": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "filter_bar",
          "title": "Type",
          "type": "string"
        },
        "search": {
          "default": true,
          "title": "Search",
          "type": "boolean"
        },
        "selects": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Selects",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "FilterBarWidget",
      "type": "object"
    },
    "FilterChipsWidget": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "filter_chips",
          "title": "Type",
          "type": "string"
        },
        "dimension": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Dimension",
          "type": "string"
        },
        "multi": {
          "default": true,
          "title": "Multi",
          "type": "boolean"
        },
        "chip_style": {
          "default": "left-border-color",
          "enum": [
            "left-border-color",
            "filled",
            "dot"
          ],
          "title": "Chip Style",
          "type": "string"
        }
      },
      "required": [
        "type",
        "dimension"
      ],
      "title": "FilterChipsWidget",
      "type": "object"
    },
    "HeaderLayout": {
      "additionalProperties": true,
      "properties": {
        "subtitle": {
          "default": "",
          "maxLength": 300,
          "title": "Subtitle",
          "type": "string"
        },
        "widgets": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "actions": "#/$defs/ActionsWidget",
                "filter_bar": "#/$defs/FilterBarWidget",
                "filter_chips": "#/$defs/FilterChipsWidget",
                "legend": "#/$defs/LegendWidget",
                "note": "#/$defs/NoteWidget",
                "progress_by_dimension": "#/$defs/ProgressWidget",
                "stats": "#/$defs/StatsWidget",
                "title": "#/$defs/TitleWidget"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TitleWidget"
              },
              {
                "$ref": "#/$defs/ActionsWidget"
              },
              {
                "$ref": "#/$defs/ProgressWidget"
              },
              {
                "$ref": "#/$defs/FilterBarWidget"
              },
              {
                "$ref": "#/$defs/FilterChipsWidget"
              },
              {
                "$ref": "#/$defs/StatsWidget"
              },
              {
                "$ref": "#/$defs/NoteWidget"
              },
              {
                "$ref": "#/$defs/LegendWidget"
              }
            ]
          },
          "maxItems": 20,
          "title": "Widgets",
          "type": "array"
        }
      },
      "title": "HeaderLayout",
      "type": "object"
    },
    "HighlightWipRule": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "highlight_wip_exceeded",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "type"
      ],
      "title": "HighlightWipRule",
      "type": "object"
    },
    "ImageBackground": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "image",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "maxLength": 1950,
          "title": "Url",
          "type": "string"
        },
        "overlay": {
          "default": "#000000",
          "maxLength": 48,
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|\\{[a-z][a-z0-9-]{0,39}\\})$",
          "title": "Overlay",
          "type": "string"
        },
        "overlay_opacity": {
          "default": 0.4,
          "maximum": 1,
          "minimum": 0,
          "title": "Overlay Opacity",
          "type": "number"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "ImageBackground",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": true,
      "properties": {
        "header": {
          "$ref": "#/$defs/HeaderLayout",
          "default": {
            "subtitle": "",
            "widgets": []
          }
        },
        "footer_note": {
          "default": "",
          "maxLength": 1000,
          "title": "Footer Note",
          "type": "string"
        },
        "board": {
          "$ref": "#/$defs/BoardLayout",
          "default": {
            "swimlanes": null
          }
        },
        "column": {
          "$ref": "#/$defs/ColumnLayout",
          "default": {
            "min_width": 280,
            "fixed_width": null,
            "radius": 10,
            "header_style": "flat-with-divider",
            "show_count": true,
            "show_wip": true,
            "collapsible": false,
            "empty_text": "Пусто"
          }
        },
        "card": {
          "$ref": "#/$defs/CardLayout",
          "default": {
            "radius": 8,
            "padding": [
              10,
              12
            ],
            "gap": 8,
            "shadow": "none",
            "border": true,
            "hover": "border",
            "accent": {
              "source": "none",
              "style": "left-border",
              "width": 3
            },
            "face": [
              "title",
              "description",
              "badges"
            ],
            "badges": [],
            "custom_text": ""
          }
        },
        "editor": {
          "$ref": "#/$defs/EditorLayout",
          "default": {
            "type": "drawer",
            "fields_grid": 1,
            "fields": []
          }
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "LegendWidget": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "legend",
          "title": "Type",
          "type": "string"
        },
        "dimension": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Dimension",
          "type": "string"
        }
      },
      "required": [
        "type",
        "dimension"
      ],
      "title": "LegendWidget",
      "type": "object"
    },
    "LinearGradientBackground": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "linear-gradient",
          "title": "Type",
          "type": "string"
        },
        "angle": {
          "default": 180,
          "maximum": 360,
          "minimum": 0,
          "title": "Angle",
          "type": "number"
        },
        "stops": {
          "items": {
            "maxLength": 48,
            "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|\\{[a-z][a-z0-9-]{0,39}\\})$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Stops",
          "type": "array"
        }
      },
      "required": [
        "type",
        "stops"
      ],
      "title": "LinearGradientBackground",
      "type": "object"
    },
    "NoteWidget": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "note",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "NoteWidget",
      "type": "object"
    },
    "ProgressWidget": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "progress_by_dimension",
          "title": "Type",
          "type": "string"
        },
        "dimension": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Dimension",
          "type": "string"
        },
        "done_rule": {
          "default": "column_kind:done",
          "pattern": "^(column_kind:[a-z_]+|column:[A-Za-z0-9_-]+)$",
          "title": "Done Rule",
          "type": "string"
        },
        "show_hint": {
          "default": true,
          "title": "Show Hint",
          "type": "boolean"
        },
        "show_counter": {
          "default": true,
          "title": "Show Counter",
          "type": "boolean"
        },
        "bar_color": {
          "default": "{accent}",
          "maxLength": 48,
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|\\{[a-z][a-z0-9-]{0,39}\\})$",
          "title": "Bar Color",
          "type": "string"
        }
      },
      "required": [
        "type",
        "dimension"
      ],
      "title": "ProgressWidget",
      "type": "object"
    },
    "RadialGradientBackground": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "radial-gradient",
          "title": "Type",
          "type": "string"
        },
        "stops": {
          "items": {
            "maxLength": 48,
            "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|\\{[a-z][a-z0-9-]{0,39}\\})$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Stops",
          "type": "array"
        }
      },
      "required": [
        "type",
        "stops"
      ],
      "title": "RadialGradientBackground",
      "type": "object"
    },
    "SetCompletedRule": {
      "additionalProperties": true,
      "description": "При переносе в колонку данного вида — проставить дату завершения.",
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "set_completed_on_kind",
          "title": "Type",
          "type": "string"
        },
        "column_kind": {
          "default": "done",
          "enum": [
            "backlog",
            "todo",
            "in_progress",
            "review",
            "done",
            "custom"
          ],
          "title": "Column Kind",
          "type": "string"
        }
      },
      "required": [
        "key",
        "type"
      ],
      "title": "SetCompletedRule",
      "type": "object"
    },
    "StatsWidget": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "stats",
          "title": "Type",
          "type": "string"
        },
        "metrics": {
          "default": [
            "total",
            "in_progress"
          ],
          "items": {
            "enum": [
              "total",
              "in_progress",
              "overdue",
              "wip_exceeded"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Metrics",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "StatsWidget",
      "type": "object"
    },
    "Theme": {
      "additionalProperties": true,
      "properties": {
        "mode": {
          "default": "light",
          "enum": [
            "light",
            "dark",
            "both"
          ],
          "title": "Mode",
          "type": "string"
        },
        "tokens": {
          "default": {},
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,39}$": {
              "maxLength": 9,
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          },
          "title": "Tokens",
          "type": "object"
        },
        "alt_tokens": {
          "default": {},
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,39}$": {
              "maxLength": 9,
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "type": "string"
            }
          },
          "title": "Alt Tokens",
          "type": "object"
        },
        "density": {
          "default": "comfortable",
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "title": "Density",
          "type": "string"
        },
        "header_background": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "color": "#/$defs/ColorBackground",
                  "image": "#/$defs/ImageBackground",
                  "linear-gradient": "#/$defs/LinearGradientBackground",
                  "radial-gradient": "#/$defs/RadialGradientBackground"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ColorBackground"
                },
                {
                  "$ref": "#/$defs/LinearGradientBackground"
                },
                {
                  "$ref": "#/$defs/RadialGradientBackground"
                },
                {
                  "$ref": "#/$defs/ImageBackground"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Background"
        },
        "board_background": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "color": "#/$defs/ColorBackground",
                  "image": "#/$defs/ImageBackground",
                  "linear-gradient": "#/$defs/LinearGradientBackground",
                  "radial-gradient": "#/$defs/RadialGradientBackground"
