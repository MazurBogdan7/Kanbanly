# Скопируйте в .env. Файл .env в репозиторий не попадает.
KANBANLY_ENV=dev
KANBANLY_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
COMPOSE_PROFILES=localdb
POSTGRES_PASSWORD=kanbanly
KANBANLY_DATABASE_URL=postgresql+asyncpg://kanbanly:kanbanly@db:5432/kanbanly
# В dev по HTTP. В prod обязательно true.
KANBANLY_COOKIE_SECURE=false
# Порт сайта на этом компьютере; поменяйте, если 8080 занят, и исправьте адрес ниже.
KANBANLY_WEB_PORT=8080
KANBANLY_PUBLIC_URL=http://localhost:8080
KANBANLY_SMTP_HOST=mailhog
KANBANLY_SMTP_PORT=1025
