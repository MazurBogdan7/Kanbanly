# На сервере: cp .env.production.example .env и заполнить все значения.
KANBANLY_ENV=prod
# Домен, A-запись которого указывает на сервер. Сертификат Caddy получит сам.
KANBANLY_DOMAIN=kanban.example.com
KANBANLY_PUBLIC_URL=https://kanban.example.com
KANBANLY_COOKIE_SECURE=true
# openssl rand -hex 32
KANBANLY_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
# --- База данных: выберите один из двух вариантов ---
# Вариант 1. База на этом же сервере (контейнер db). openssl rand -hex 16;
# пароль должен совпадать в обеих строках.
COMPOSE_PROFILES=localdb
POSTGRES_PASSWORD=replace-with-strong-password
KANBANLY_DATABASE_URL=postgresql+asyncpg://kanbanly:replace-with-strong-password@db:5432/kanbanly
# Вариант 2. Внешняя база (управляемый PostgreSQL 14+ у хостинга или другой сервер):
# закомментируйте три строки выше и раскомментируйте строку ниже.
# ?ssl=require шифрует соединение, без него пароль и данные идут по сети открыто.
# KANBANLY_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require
# Почтовый сервер для писем сброса пароля. Без него письма не уйдут.
KANBANLY_SMTP_HOST=smtp.example.com
KANBANLY_SMTP_PORT=587
KANBANLY_SMTP_USERNAME=no-reply@example.com
KANBANLY_SMTP_PASSWORD=replace-with-smtp-password
KANBANLY_SMTP_STARTTLS=true
KANBANLY_MAIL_FROM=Kanbanly <no-reply@example.com>
